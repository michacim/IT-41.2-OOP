<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="233.0" prefWidth="330.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.example.a06_zahlenraten.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <TextField fx:id="listSizeField" nodeOrientation="LEFT_TO_RIGHT" prefHeight="27.0" prefWidth="153.0" promptText="Anzahl der Zahlen" />
      <Button mnemonicParsing="false" nodeOrientation="LEFT_TO_RIGHT" onAction="#onCreate" text="Erzeuge Liste und Zufallszahl" />
      <TextField fx:id="callNumberField" nodeOrientation="LEFT_TO_RIGHT" prefHeight="27.0" prefWidth="192.0" promptText="Tipp(Zahl)" />
      <Button mnemonicParsing="false" onAction="#onCall" text="Raten" />
      <Label fx:id="resultLabel" nodeOrientation="LEFT_TO_RIGHT" prefHeight="19.0" prefWidth="301.0" style="-fx-background-color: #aaa;">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
   </children>
</VBox>
